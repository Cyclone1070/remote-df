{
  "name": "remote-df",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "sh tests/tier1-unit/run.sh && node --test tests/tier2-contract/*.mjs",
    "test:unit": "sh tests/tier1-unit/run.sh",
    "test:contract": "node --test tests/tier2-contract/*.mjs",
    "test:integration": "node tests/tier3-integration/run.mjs",
    "test:diagnose": "node tests/diagnostics/full-state.mjs",
    "gate": "npm test && npm run test:integration",
    "bench": "bash tests/bench/matrix.sh",
    "bench:matrix": "node tests/diagnostics/interaction-matrix.mjs",
    "bench:summary": "node tests/bench/summarise.mjs",
    "net:shape": "ssh \"$DF_SHAPE_HOST\" \"cat > /tmp/df-simulate.sh && chmod +x /tmp/df-simulate.sh\" < tests/net/simulate.sh && ssh \"$DF_SHAPE_HOST\" \"sudo -n /tmp/df-simulate.sh apply 1500\"",
    "net:clear": "ssh \"$DF_SHAPE_HOST\" \"sudo -n /tmp/df-simulate.sh clear\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyclone1070/remote-df.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Cyclone1070/remote-df/issues"
  },
  "homepage": "https://github.com/Cyclone1070/remote-df#readme",
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
