# Remote-DF Configuration

# Host path containing Dwarf Fortress installation (mounted to /game in container)
DF_DIR=/tmp/df_install

# Port configuration
PORT=8484
STREAM_PORT=8485

# Optional: STUN server for WebRTC NAT hole punching (defaults to Google STUN if omitted)
# STUN_SERVER=stun:stun.l.google.com:19302

# Optional: Cloudflare Named Tunnel Token
# Leave blank to automatically generate a free, zero-config Quick Tunnel (*.trycloudflare.com)
CF_TUNNEL_TOKEN=
